# Server
PORT=5000

# MongoDB Atlas connection string
# Ví dụ: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/virtual_study_room?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/virtual_study_room?retryWrites=true&w=majority

# JWT — dùng chuỗi bí mật dài, ngẫu nhiên (ít nhất 32 ký tự)
JWT_SECRET=change_me_to_a_long_random_secret_key

# URL frontend (CORS + Socket.io origin)
# Local: http://localhost:3000
# Production (Vercel): https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Email OTP Service:
# Cách 1 (Khuyên dùng khi deploy Render/Cloud): Dùng Resend HTTP API (Port 443 - không bao giờ bị Render chặn)
# Lấy miễn phí tại: https://resend.com
RESEND_API_KEY=
RESEND_FROM="Virtual Study Room <onboarding@resend.dev>"

# Cách 2 (Dùng Brevo HTTP API - 300 mail/ngày miễn phí tới mọi email):
# Lấy tại: https://brevo.com
BREVO_API_KEY=
BREVO_FROM_EMAIL=your_email@gmail.com

# Cách 3 (Dùng khi chạy Local hoặc Host cho phép cổng SMTP 465/587):
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

