# Server
PORT=5000

# MongoDB Atlas connection string
# Ví dụ: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/virtual_study_room?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/virtual_study_room?retryWrites=true&w=majority

# JWT — dùng chuỗi bí mật dài, ngẫu nhiên (ít nhất 32 ký tự)
JWT_SECRET=change_me_to_a_long_random_secret_key

# URL frontend (CORS + Socket.io origin)
# Local: http://localhost:3000
# Production (Vercel): https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
